# Copy this file to server/.env and fill in the real values.
# server/.env holds the database password - it is in .gitignore, never commit it.

# --- PostGIS connection (ftagisdatabase, reached over Tailscale) ---
DB_host=100.105.1.96
DB_port=5432
DB_user=postgres
DB_password=ask_the_team
DB_name=ftagisdatabase

# --- Demo data ---
# auto  = use the database, but show labelled demo data if it can't be reached
# false = database only (show an error if it fails)
# true  = demo data only, don't connect
DEMO_MODE=auto

PORT=3000

# --- Sign-in passwords per role (who sees what: src/roles_config.js) ---
# If a line is missing the server uses the demo password shown here.
# Change them before the dashboard is used outside the team!
PASS_STAFF=staff2026
PASS_MANAGER=manager2026
PASS_RESEARCHER=research2026
PASS_ADMIN=admin2026
# Any long random text. Keeps people signed in when the server restarts.
AUTH_SECRET=change_me_to_a_long_random_text
