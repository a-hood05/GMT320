# Copy this file to server/.env and fill in your own values.
# server/.env holds your password - never commit it to GitHub.

# --- PostGIS connection ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=smart_irrigation
PGUSER=postgres
PGPASSWORD=your_password_here

# --- The table with the sensor recordings ---
# Can include the schema, e.g. public.sensor_readings
READINGS_TABLE=sensor_readings
# Column that holds the sensor number (matches "id" in sensor.geojson)
SENSOR_ID_COLUMN=sensor_id
# Column with the date/time of each recording (timestamp type)
TIME_COLUMN=recorded_at

# --- Demo data ---
# auto  = use PostGIS, but fall back to demo data if the database can't be reached
# false = PostGIS only (show an error if it fails)
# true  = demo data only, don't connect
DEMO_MODE=auto

PORT=3000
